---
import Base from '../../layouts/Base.astro';
import { getTags } from '../../lib/content';

const tags = await getTags();
---

<Base title="Tags" description="Notes grouped by topic.">
  <div>
    <h1 class="page-title">Tags</h1>
    {
      tags.length ? (
        <ul class="tag-cloud">
          {tags.map((tag) => (
            <li>
              <a href={`/tags/${tag.slug}/`}>{tag.name}</a> <span>{tag.posts.length}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">No tags yet. Add <code>tags</code> to a note’s front matter.</p>
      )
    }
  </div>
</Base>
